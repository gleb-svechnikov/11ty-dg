<!DOCTYPE html>
<html lang="en" data-theme="auto">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title or "Digital garden" }}</title>
    <script>
      document.documentElement.dataset.theme = localStorage.getItem("garden-theme") || "auto";
    </script>
    <link rel="stylesheet" href="/css/garden.css">
    <link rel="stylesheet" href="/pagefind/pagefind-ui.css">
    <script src="/js/mathjax-config.js"></script>
    <script
      id="MathJax-script"
      async
      src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"
    ></script>
  </head>
  <body{% if wide %} class="wide"{% endif %}>
    <header class="site-header">
      <a class="site-home" href="/">Digital garden</a>
      <div class="site-header-actions">
        <div id="search" class="site-search"></div>
        <button type="button" class="theme-toggle" aria-label="Color theme: system" title="Color theme: system">
          <svg class="theme-icon theme-icon--auto" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="8"/>
            <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"/>
          </svg>
          <svg class="theme-icon theme-icon--light" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
          </svg>
          <svg class="theme-icon theme-icon--dark" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/>
          </svg>
        </button>
      </div>
    </header>
    {% if coverUrl %}
      <figure class="hero" data-pagefind-ignore>
        <img src="{{ coverUrl }}" alt="" style="object-position: {{ coverPosition }}">
      </figure>
    {% endif %}
    <main{% if gardenVault %} data-pagefind-body data-pagefind-meta="vault:{{ gardenVault }}" data-pagefind-filter="vault:{{ gardenVault }}"{% endif %}>
      {{ content | safe }}
      {% if gardenEditedAt %}
        <footer class="article-meta" data-pagefind-ignore>
          <p class="article-edited">Last edited <time datetime="{{ gardenEditedAt }}">{{ gardenEditedAt | formatDateTime }}</time></p>
        </footer>
      {% endif %}
    </main>
    <script src="/js/theme.js"></script>
    <script src="/js/copy-code.js"></script>
    <script type="module" src="/js/mermaid.js"></script>
    <script src="/pagefind/pagefind-ui.js"></script>
    <script src="/js/search.js"></script>
  </body>
</html>
